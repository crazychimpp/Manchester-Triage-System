# Local Ollama host or remote OpenAI-compatible API host running Gemma.
VITE_GEMMA_HOST=http://localhost:11434

# Model tag. gemma3:4b runs on a single workstation GPU; gemma3:27b if you have one.
VITE_GEMMA_MODEL=gemma3:4b

# Server-side API key for remote OpenAI-compatible hosts (never exposed to browser)
SPUR_API_KEY=your-spur-key-here

# "ollama" | "openai" | "mock"
VITE_GEMMA_API=ollama
